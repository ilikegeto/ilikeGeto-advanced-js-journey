<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Sketch html</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="style.css">

        <style>
            * {
                font-family: 'Montserrat', sans-serif;
            }
        </style>
    </head>
    <body class="bodi">
        <div id="flex" class="bodi">
            <div id="title" class="bodi"><h1>Sketch Book!</h1></div>
            <div id="content" class="bodi">
                <div id="board"></div>
                <div id="button">
                    <button id="resettool" class="buton" onclick="reset(); swapColor('black')">Reset</button>
                    <button id="erasetool" class="buton" onclick="swapColor('white'); OutlineColor('red')">Eraser</button>
                    <button id="drwtool" class="buton" onclick="swapColor('black'); OutlineColor('black')">Pen</button>
                </div>
                <div id="sizeInput">
                    <input id="inputPix" type="text" placeholder="Pixel size" value="16">
                    <button id="addpix">Add Pixel</button>
                </div>
            </div>
        </div>
        <script src="sketch.js"></script>
    </body>
</html>
