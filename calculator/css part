* {
    font-family: 'Montserrat', sans-serif;
}

.calculatorBody{
    height: 500px;
    background-color: gray;
    width: 300px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-direction: column;
    padding: 10px;
    gap: 10px;
    border-radius: 10px;
}
.number{
    display: grid;
    grid-template-columns: repeat(4, 70px);
    grid-template-rows: repeat(4, 70px);
    gap: 2px;
    height: 360px;
    border-radius: 100px;
}
#display{
    width: 280px;
    height: 60px;
    border-radius: 5px;
    background-color: hsl(0, 0%, 86%);
    border: 1px solid  hsl(0, 0%, 39%);
    font-size: xx-large;
}

#submit{
    grid-column: span 2;
    width: 100%;
}
.tetot{
    border: none;
    border-radius: 100px;
    background-color: black;
    color: white;
    font-size: x-large;
}

#container{
    display: flex;
    height: 100vh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
