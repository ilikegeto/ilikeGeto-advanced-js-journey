        valueArr.pop();
        console.log(valueArr)
        display.value = valueArr.join("")
    }
})

// operator

function operatorCheck(symbol){
    let lastChar = valueArr[valueArr.length - 1];
    let addoperator = " " + symbol + " ";

    if (operatorlist.includes(lastChar)) {
        console.log("!!{[no operator spam!!]}")
        valueArr.pop()
    }

    valueArr.push(addoperator)
    console.log(valueArr)
    display.value = valueArr.join("")
}

plus.addEventListener('click', () =>operatorCheck(plus.textContent))
minus.addEventListener('click', () =>operatorCheck(minus.textContent))
multiply.addEventListener('click', () =>operatorCheck(multiply.textContent))
divide.addEventListener('click', () =>operatorCheck(divide.textContent))


submit.addEventListener('click', function(){

    let stringCal = valueArr.join("")
    let calculation = stringCal.split(" ")

    let input1 = Number(calculation[0])
    let operatorcal = calculation[1]
    let input2 = Number(calculation[2])

    console.log(input1)
    console.log(operatorcal)
    console.log(input2)

    // result
    let result = 0
    if (operatorcal === "+") {
        result = input1 + input2;
    } else if(operatorcal === "-") {
        result = input1 - input2;
    } else if(operatorcal === "*") {
        result = input1 * input2;
    } else if(operatorcal === "/") {
        result = input1 / input2;
    }

    display.value = result
    valueArr = [result.toString()]
})
